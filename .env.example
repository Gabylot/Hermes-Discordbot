# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Channel IDs (copy from Discord - right click channel > Copy ID)
CHANNEL_ADMIN_LOG=

# Roles (verification threads ping these)
ROLE_NCO=
ROLE_OFFICER=

# Roles that skip verification (guards on the welcome buttons)
ROLE_VERIFIED=
ROLE_ALLIED=

# Verification thread archive
CHANNEL_VERIFY_ARCHIVE=

# New-member welcome (posted in the enlistees channel when someone joins)
CHANNEL_ENLISTEES=
CHANNEL_WELCOME=
CHANNEL_VERIFICATION=

# Statistics (activity events + voice snapshots are sent to the backend API)
# Minutes between voice-channel occupancy snapshots (0 disables)
STAT_VOICE_INTERVAL_MIN=5
# Comma-separated voice channel IDs excluded from occupancy snapshots (AFK)
STAT_AFK_CHANNEL_IDS=

# Backend API
API_BASE_URL=http://localhost:8000/api
API_SECRET=your_internal_api_secret_here
